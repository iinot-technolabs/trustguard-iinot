# Template — install.sh replaces @TG_HOME@ and @NODE@ and installs it as /etc/systemd/system/trustguard-oracle.service
[Unit]
Description=TrustGuard IIoT weather / heat-stress oracle -> Fabric
After=network-online.target docker.service trustguard-backend.service
Wants=network-online.target
Requires=docker.service

[Service]
WorkingDirectory=@TG_HOME@/safety-simulation
Environment=TG_HOME=@TG_HOME@
EnvironmentFile=-@TG_HOME@/config/client/oracle.env
ExecStart=@NODE@ @TG_HOME@/safety-simulation/oracleService.js
Restart=always
RestartSec=30
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
