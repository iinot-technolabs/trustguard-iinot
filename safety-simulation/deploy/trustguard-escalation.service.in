# Template — install.sh replaces @TG_HOME@ and @NODE@ and installs it as /etc/systemd/system/trustguard-escalation.service
[Unit]
Description=TrustGuard IIoT auto-escalation of unacknowledged incidents
After=network-online.target docker.service trustguard-backend.service
Wants=network-online.target
Requires=docker.service

[Service]
WorkingDirectory=@TG_HOME@/safety-simulation
Environment=TG_HOME=@TG_HOME@
EnvironmentFile=-@TG_HOME@/config/client/escalation.env
ExecStart=@NODE@ @TG_HOME@/safety-simulation/escalationService.js
Restart=always
RestartSec=15
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
