# Copy to escalation/.env (git-ignored) to send Telegram notifications, then:
#   systemctl restart trustguard-escalation && node escalationService.js --telegram-test
# 1. In Telegram, message @BotFather → /newbot → copy the token below.
# 2. Each person opens the bot and sends /start.
# 3. Get their chat ids:  curl -s https://api.telegram.org/bot<TOKEN>/getUpdates | grep -o '"chat":{"id":[-0-9]*'
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_SUPERVISORS=
TELEGRAM_CHAT_SAFETYOFFICER=
TELEGRAM_CHAT_REGULATOR=
